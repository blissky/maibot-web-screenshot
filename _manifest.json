{
  "manifest_version": 2,
  "id": "blissky.web-screenshot",
  "version": "1.0.0",
  "name": "网页全页截图",
  "description": "通过特定指令与网页链接的配置映射，截取整个网页并发送到当前聊天。",
  "author": {
    "name": "blissky",
    "url": "https://github.com/blissky"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/blissky/maibot-web-screenshot"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.2",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "media",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "camera"
    }
  },
  "capabilities": ["config.get", "send.text", "send.image"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
